# Proxy TLS do Redmine Motriz.
# O Caddy obtém e renova o certificado do Let's Encrypt sozinho, desde que:
#   - DOMINIO tenha um registro A apontando para este servidor
#   - as portas 80 e 443 estejam acessíveis pela internet (o desafio HTTP-01
#     do Let's Encrypt bate na 80)
{
	email {$ACME_EMAIL}
}

{$DOMINIO} {
	encode zstd gzip

	# O Redmine precisa saber que a ponta é HTTPS para montar URLs e cookies
	# corretamente. O Caddy já envia X-Forwarded-*; explicitamos por clareza.
	reverse_proxy redmine:3000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
