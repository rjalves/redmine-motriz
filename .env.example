# Copie para .env e preencha. O .env NÃO vai para o repositório.
POSTGRES_DB=redmine
POSTGRES_USER=redmine
POSTGRES_PASSWORD=            # openssl rand -hex 24
SECRET_KEY_BASE=              # openssl rand -hex 64
REDMINE_LANG=pt-BR
TZ=America/Sao_Paulo
HTTP_PORT=80

# --- HTTPS ---
# Preencha e suba com: docker compose --profile tls up -d
# Exige registro A do DOMINIO apontando para o IP do servidor.
DOMINIO=
ACME_EMAIL=
# Com o perfil tls ativo o Caddy assume 80/443 — mova o Redmine:
# HTTP_PORT=8080
# Descomente APENAS no primeiro start, depois remova:
# REDMINE_DEFAULT_DATA=1

# --- SSO com Google (plugin redmine_google_sso) ---
# Sem as duas variáveis o middleware não é instalado e o botão não aparece;
# o Redmine sobe normalmente e o login por senha continua funcionando.
# Crie um OAuth client (tipo "Aplicativo da Web") em console.cloud.google.com
# e cadastre o redirect URI: https://SEU_DOMINIO/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
