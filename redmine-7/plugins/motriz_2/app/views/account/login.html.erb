<%= call_hook :view_account_login_top %>

<%# O fundo pode vir do pacote do plugin ou de um envio do administrador, que
    mora em files/ e sai por rota própria. O helper resolve as duas formas; se
    não houver nenhum selecionado, sai sem style em vez de um url() vazio. %>
<% fundo = motriz_wallpaper_src(RedmineAsapTheme::Wallpapers.selecionado) %>
<div id="login-form" class="w-full h-full bg-fixed flex bg-no-repeat bg-left-top bg-cover" style="<%= "background-image: url(#{fundo})" if fundo %>">
  <%# rounded-2xl = 1rem, o mesmo --motriz-raio-lg do tema. overflow-hidden é o que
      faz o painel verde escuro respeitar a curva: sem ele, o filho de canto reto
      vaza por cima do raio do pai. %>
  <div class="flex flex-col md:flex-row bg-white items-stretch justify-center
            h-auto my-auto mx-8 md:mx-auto shadow-md rounded-2xl overflow-hidden
            w-full md:w-4/5 lg:w-3/5 xl:w-3/5 2xl:w-2/5">
    <div class="p-8 flex items-center justify-center flex-col
            w-full md:w-2/5 bg-blue-700">

      <div class="motriz-logo hidden md:flex items-center justify-center">
        <%= image_tag 'logo-motriz-digital-negativo.png', :plugin => 'motriz_2', class: 'h-14 w-auto max-w-none', alt: 'Motriz Digital' %>
      </div>
      <div class="text-center text-blue-100 w-full my-0 md:my-4 font-medium text-lg">
        <%= Setting.app_title %>
      </div>
    </div>
    <div class="w-full h-full md:w-3/5 flex flex-col px-12 py-8 md:py-14 ">
      <%= form_tag(signin_path, onsubmit: 'return keepAnchorOnSignIn(this);', data: {turbo: false}, class:"mb-6") do %>
        <%= back_url_hidden_field_tag %>

        <div class="mb-6">
          <label for="username"><%=l(:field_login)%></label>
          <%= text_field_tag 'username', params[:username], :tabindex => '1', :autocomplete => 'username', :autofocus => params[:username].blank? %>
        </div>

        <div class="mb-6">
          <label for="password">
            <%=l(:field_password)%>
          </label>
          <%= password_field_tag 'password', nil, :tabindex => '2', :autocomplete => 'current-password', :autofocus => params[:username].present? %>
          <%= link_to l(:label_password_lost), lost_password_path, :class => "lost_password ml-auto text-blue-700 hover:text-blue-800 dark:text-blue-100 dark:hover:text-blue-200 text-xs" if Setting.lost_password? %>
        </div>

        <%# mb-6 é o mesmo respiro usado entre os campos acima, para o formulário
            manter um ritmo vertical só. %>
        <% if Setting.autologin? %>
          <div class="mb-6">
            <label for="autologin"><%= check_box_tag 'autologin', 1, false, :tabindex => 4 %> <%= l(:label_stay_logged_in) %></label>
          </div>
        <% end %>

        <input type="submit" name="login" value="<%=l(:button_login)%>" tabindex="5" id="login-submit" class="w-full cursor-pointer flex text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 font-medium rounded text-sm px-3 py-2 dark:bg-blue-600 dark:hover:bg-blue-700 focus:outline-none dark:focus:ring-blue-800" />
      <% end %>

      <%= call_hook :view_account_login_bottom %>

    </div>

  </div>
