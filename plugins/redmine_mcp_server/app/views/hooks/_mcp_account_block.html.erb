<%#
  Este parcial é renderizado pelo hook :view_my_account, que tanto o core
  (my/account.html.erb:53) quanto o motriz_2 (user_settings/_preferences.html.erb:15)
  chamam de DENTRO de um <form>. Portanto aqui NÃO pode haver <form>, e nem
  button_to nem form_tag podem ser usados: o parser HTML descarta o form
  aninhado e o botão passa a submeter o formulário de fora, sem nunca chegar
  ao McpAccessController. Só um link. O que muda estado mora em mcp_access#show.

  Há um teste de regressão para isso em test/functional/mcp_access_controller_test.rb.
%>
<% if RedmineMcpServer::Config.enabled? %>
  <p id="mcp-access-link">
    <label><%= l(:label_mcp_server) %></label>
    <%= link_to l(:label_mcp_manage_access), mcp_access_path %>
    <em class="info">
      <%= RedmineMcpServer::Config.enabled_for?(User.current) ? l(:text_mcp_status_on) : l(:text_mcp_status_off) %>
    </em>
  </p>
<% end %>
