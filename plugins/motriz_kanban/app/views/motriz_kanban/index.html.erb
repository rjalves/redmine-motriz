<div class="contextual">
  <%# Atalho para a mesma consulta em formato de tabela. O caminho de volta
      importa: quem chega no quadro pelo menu não passou pelo alternador da
      lista, então precisa de uma saída visível. %>
  <%= link_to l(:label_issue_plural),
              _project_issues_path(@project, params: request.query_parameters.except('view')),
              :class => 'icon icon-list' %>
  <% if User.current.allowed_to?(:add_issues, @project, :global => true) &&
        (@project.nil? || Issue.allowed_target_trackers(@project).any?) %>
    <%= link_to sprite_icon('add', l(:label_issue_new)),
                _new_project_issue_path(@project), :class => 'icon icon-add new-issue' %>
  <% end %>
</div>

<h2><%= @query.new_record? ? l(:label_motriz_quadro) : @query.name %></h2>
<% html_title(@query.new_record? ? l(:label_motriz_quadro) : @query.name) %>

<%# A classe board-view-mode é o que esconde o bloco "Colunas" do formulário de
    filtros (assets/src/issue.css) — no quadro quem manda são as colunas de
    situação, não as colunas de tabela. %>
<%= form_tag(url_for(:controller => 'motriz_kanban', :action => 'index',
                     :project_id => @project),
             :method => :get, :id => 'query_form', :class => 'board-view-mode') do %>
  <%= render :partial => 'queries/query_form' %>
<% end %>

<% if @query.valid? %>
  <%= render :partial => 'issues/board',
             :locals => { :issues => @issues,
                          :query => @query,
                          :project => @project,
                          :limit => MotrizKanbanController::LIMITE_DE_CARTOES } %>
<% end %>

<%# A barra lateral traz as consultas salvas. O query_links do core usa params
    vazios quando o controller não é o de tarefas, então os links saem como
    /quadro?query_id=N e voltam para cá em vez de jogar na tabela. %>
<% content_for :sidebar do %>
  <%= render :partial => 'issues/sidebar' %>
<% end %>

<%= context_menu %>
